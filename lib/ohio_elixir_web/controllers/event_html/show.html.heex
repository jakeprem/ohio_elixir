<Layouts.app flash={@flash} current_user={@current_user}>
  <%!-- Event Header --%>
  <header class="border-b border-base-300 py-8">
    <div class="max-w-5xl mx-auto px-6">
      <div class="mb-4">
        <.link navigate={~p"/events"} class="text-base-content/60 hover:text-base-content flex items-center gap-1 text-sm">
          <.icon name="hero-arrow-left" class="w-4 h-4" />
          Back to events
        </.link>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">{@event.title}</h1>

      <div class="flex flex-wrap items-center gap-2">
        <.format_badge format={@event.format} />
        <%= if Ash.can?({@event, :update}, @current_user) do %>
          <span class={[
            "badge badge-sm",
            @event.status == :draft && "badge-warning",
            @event.status == :published && "badge-success",
            @event.status == :cancelled && "badge-error"
          ]}>
            {Phoenix.Naming.humanize(@event.status)}
          </span>
        <% end %>
        <%= if @event.rsvp_count && @event.rsvp_count > 0 do %>
          <span class="flex items-center gap-1 text-base-content/60">
            <.icon name="hero-users" class="w-5 h-5" />
            {@event.rsvp_count} {if @event.rsvp_count == 1, do: "person", else: "people"} going
          </span>
        <% end %>
      </div>
    </div>
  </header>

  <%!-- Event Details --%>
  <div class="max-w-5xl mx-auto px-6 py-8">
    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Main Content --%>
      <div class="md:col-span-2 space-y-6">
        <%!-- Date and Time --%>
        <div class="border border-base-300 p-6">
          <h2 class="text-lg font-bold mb-4">Date & Time</h2>
          <div class="flex flex-wrap items-center gap-4 text-base-content/70">
            <span class="flex items-center gap-2">
              <.icon name="hero-calendar" class="w-5 h-5" />
              {format_date(@event.starts_at, @event.timezone)}
            </span>
            <span class="flex items-center gap-2">
              <.icon name="hero-clock" class="w-5 h-5" />
              {format_time(@event.starts_at, @event.timezone)}
              <%= if @event.ends_at do %>
                - {format_time(@event.ends_at, @event.timezone)}
              <% end %>
            </span>
          </div>
        </div>

        <%!-- Location --%>
        <%= if @event.venue || @event.format in [:online, :hybrid] do %>
          <div class="border border-base-300 p-6">
            <h2 class="text-lg font-bold mb-4">Location</h2>
            <%= if @event.venue do %>
              <div class="flex items-start gap-2">
                <.icon name="hero-map-pin" class="w-5 h-5 mt-0.5 text-base-content/70" />
                <div>
                  <p class="font-medium">{@event.venue.name}</p>
                  <%= if @event.venue.address_line_1 do %>
                    <p class="text-base-content/60">{@event.venue.address_line_1}</p>
                  <% end %>
                  <%= if @event.venue.city do %>
                    <p class="text-base-content/60">
                      {@event.venue.city}, {@event.venue.state} {@event.venue.postal_code}
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
            <%= if @event.format in [:online, :hybrid] do %>
              <%= if is_binary(@event.meeting_url) do %>
                <div class="flex items-start gap-2 mt-4">
                  <.icon name="hero-video-camera" class="w-5 h-5 text-base-content/70 mt-0.5" />
                  <div>
                    <a href={@event.meeting_url} class="text-primary hover:underline" target="_blank">
                      Join Online
                    </a>
                    <p class="text-sm text-base-content/60 break-all">{truncate_url(@event.meeting_url, 80)}</p>
                  </div>
                </div>
              <% else %>
                <div class="flex items-center gap-2 mt-4">
                  <.icon name="hero-video-camera" class="w-5 h-5 text-base-content/70" />
                  <span class="text-base-content/50 flex items-center gap-1">
                    <.icon name="hero-lock-closed" class="w-4 h-4" />
                    RSVP to view link
                  </span>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <%!-- Description --%>
        <%= if @event.description do %>
          <div class="border border-base-300 p-6">
            <h2 class="text-lg font-bold mb-4">About this event</h2>
            <.markdown content={@event.description} class="text-base-content/80" />
          </div>
        <% end %>
      </div>

      <%!-- Sidebar --%>
      <div class="md:col-span-1 space-y-6">
        <%!-- Admin Controls --%>
        <%= if Ash.can?({@event, :update}, @current_user) do %>
          <div class="border border-base-300 p-6">
            <h2 class="text-lg font-bold mb-4">Manage Event</h2>
            <div class="space-y-3">
              <.link navigate={~p"/events/#{@event.id}/edit"} class="btn btn-outline btn-sm w-full">
                <.icon name="hero-pencil" class="w-4 h-4" />
                Edit Event
              </.link>
              <%= if @event.status == :draft and Ash.can?({@event, :publish}, @current_user) do %>
                <.link
                  href={~p"/events/#{@event.id}/publish"}
                  method="post"
                  class="btn btn-success btn-sm w-full"
                >
                  <.icon name="hero-check-circle" class="w-4 h-4" />
                  Publish Event
                </.link>
              <% end %>
              <%= if @event.status == :published and Ash.can?({@event, :cancel}, @current_user) do %>
                <.link
                  href={~p"/events/#{@event.id}/cancel"}
                  method="post"
                  class="btn btn-error btn-outline btn-sm w-full"
                  data-confirm="Are you sure you want to cancel this event?"
                >
                  <.icon name="hero-x-circle" class="w-4 h-4" />
                  Cancel Event
                </.link>
              <% end %>
            </div>
          </div>
        <% end %>

        <%!-- Attendee List - admin only --%>
        <%= if @current_user && @current_user.role == :admin do %>
          <div class="border border-base-300 p-6">
            <h2 class="text-lg font-bold mb-4">
              Attendees ({length(@event.rsvps)})
            </h2>
            <div class="space-y-4">
              <%= if @event.rsvps == [] do %>
                <p class="text-sm text-base-content/60">No RSVPs yet</p>
              <% end %>
              <.attendee_group label="In Person" rsvps={@attendees_by_mode[:in_person]} />
              <.attendee_group label="Online" rsvps={@attendees_by_mode[:online]} />
              <.attendee_group label="Unspecified" rsvps={@attendees_by_mode[nil]} />
            </div>
          </div>
        <% end %>

        <%!-- RSVP Box --%>
        <%= live_render(@conn, OhioElixirWeb.RsvpLive,
          id: "rsvp-#{@event.id}",
          session: %{"event_id" => @event.id, "mode" => @mode}
        ) %>
      </div>
    </div>
  </div>
</Layouts.app>
