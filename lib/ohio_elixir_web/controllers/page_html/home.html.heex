<Layouts.flash_group flash={@flash} />

<div class="min-h-screen">
  <%!-- Navigation --%>
  <Layouts.navbar current_user={@current_user} />

  <%!-- Hero Section --%>
  <header class="py-8 md:py-12 text-center">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-6xl font-bold mb-4 md:mb-6 leading-tight">
          Building the Future<br />with Elixir
        </h2>
        <p class="text-base md:text-lg text-base-content/60 mb-6 md:mb-8 max-w-2xl mx-auto">
          Join Ohio's vibrant community of Elixir developers, where innovation meets collaboration in the heart of the Midwest.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="#join" class="btn btn-primary px-6 py-3 font-medium">
            Join Our Community
          </a>
          <a
            href="/proposal_submission"
            class="btn btn-outline btn-primary px-6 py-3 font-medium"
          >
            Want to Speak?
          </a>
        </div>
      </div>
    </div>
  </header>

  <%!-- Upcoming Events Section --%>
  <section id="events" class="scroll-mt-5">
    <div class="max-w-5xl mx-auto px-6 py-8">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-bold">Upcoming Events</h3>
        <.link navigate={~p"/events"} class="text-primary hover:underline text-sm">
          View all events
        </.link>
      </div>

      <%= if @upcoming_events == [] do %>
        <div class="border border-base-300 p-8 text-center">
          <p class="text-base-content/60">No upcoming events scheduled. Check back soon!</p>
        </div>
      <% else %>
        <div class="space-y-4">
          <%= for event <- @upcoming_events do %>
            <div class="border border-base-300 hover:border-primary/50 transition-colors">
              <div class="p-4 text-left">
                <.link navigate={~p"/events/#{event.id}"} class="block mb-4">
                  <div class="text-sm text-base-content/50 mb-2">
                    {format_date(event.starts_at, event.timezone)} · {format_time(
                      event.starts_at,
                      event.timezone
                    )}
                  </div>
                  <h4 class="text-lg font-bold mb-2">{event.title}</h4>
                  <%= if event.description do %>
                    <p class="text-base-content/60 text-sm line-clamp-2">
                      {String.slice(event.description, 0, 200)}{if String.length(
                                                                     event.description || ""
                                                                   ) > 200, do: "..."}
                    </p>
                  <% end %>
                </.link>
                <%= if event.upcoming? do %>
                  <div class="flex flex-col sm:flex-row gap-2">
                    <%= if event.format in [:in_person, :hybrid] do %>
                      <.link navigate={~p"/events/#{event.id}?mode=in_person"} class="btn btn-primary btn-sm">
                        Join In Person
                      </.link>
                    <% end %>
                    <%= if event.format in [:online, :hybrid] do %>
                      <.link navigate={~p"/events/#{event.id}?mode=online"} class="btn btn-outline btn-primary btn-sm">
                        Join Online
                      </.link>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%!-- About Section --%>
  <section id="about" class="py-12">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h3 class="text-4xl font-bold mb-6">Who We Are</h3>
          <p class="text-base-content/60 leading-relaxed mb-4">
            Ohio Elixir is a community group comprised of anyone and everyone interested in the Elixir ecosystem.
            We host monthly meetings where guest speakers present Elixir-related content, as well as occasional
            show and tell nights where anyone can talk about what they've been working on or ask questions.
          </p>
          <p class="text-base-content/60 leading-relaxed">
            At this time we are a fully remote organization which gives us the unique opportunity to open our
            virtual doors to folks outside of Ohio. RSVP for our upcoming meeting, join our Discord, and come say "Hello!".
          </p>
        </div>
        <div class="grid grid-cols-2 border border-base-300">
          <div class="p-6 border-r border-b border-base-300">
            <h4 class="text-lg font-bold mb-3">Monthly Meetups</h4>
            <p class="text-base-content/60 text-sm">Regular gatherings with talks and discussions</p>
          </div>
          <div class="p-6 border-b border-base-300">
            <h4 class="text-lg font-bold mb-3">Remote First</h4>
            <p class="text-base-content/60 text-sm">Accessible to developers across Ohio and beyond</p>
          </div>
          <div class="p-6 border-r border-base-300">
            <h4 class="text-lg font-bold mb-3">Show & Tell</h4>
            <p class="text-base-content/60 text-sm">Share your projects and learn from others</p>
          </div>
          <div class="p-6">
            <h4 class="text-lg font-bold mb-3">Community</h4>
            <p class="text-base-content/60 text-sm">Connect with like-minded developers</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Layouts.footer />
</div>
